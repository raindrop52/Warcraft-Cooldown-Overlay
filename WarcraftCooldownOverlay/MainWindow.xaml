<Window x:Class="WarcraftCooldownOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warcraft III Cooldown Overlay 설정" Icon="Assets/app.ico" Width="900" Height="620"
        MinWidth="780" MinHeight="540" WindowStartupLocation="CenterScreen"
        Background="#151A22">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8EEF6"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="4"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#263647"/>
        </Style>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="White"/></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Warcraft III 쿨타임 오버레이" FontSize="23" FontWeight="Bold"/>
                <TextBlock Text="표시할 아이템과 스킬을 선택한 뒤 오버레이를 실행하세요."
                           Foreground="#9FB0C3" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#202936" CornerRadius="6" Padding="12,7">
                <TextBlock x:Name="StatusText" Text="Warcraft III 창 검색 중…" Foreground="#FFE58A"/>
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Background="#202936" CornerRadius="8" Padding="10" Margin="0,0,0,14">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="배치 방향" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,10,0"/>
                <RadioButton x:Name="HorizontalRadio" Content="가로" IsChecked="True" Margin="4"
                             Checked="OrientationChanged"/>
                <RadioButton x:Name="VerticalRadio" Content="세로" Margin="12,4,24,4"
                             Checked="OrientationChanged"/>
                <Button Content="모두 켜기" Click="SelectAll"/>
                <Button Content="모두 끄기" Click="ClearAll"/>
            </WrapPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="인벤토리 · 2×3" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <UniformGrid x:Name="ItemPanel" Rows="3" Columns="2"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="스킬 · 위 3칸 + 아래 4칸" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <UniformGrid x:Name="SkillTopPanel" Grid.Row="0" Rows="1" Columns="3"
                                     HorizontalAlignment="Left"/>
                        <UniformGrid x:Name="SkillBottomPanel" Grid.Row="1" Rows="1" Columns="4"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="단축키  ·  F7: 오버레이 실행/종료  ·  F8: 프로그램 종료"
                           Foreground="#79DFFF" FontWeight="Bold" FontSize="13"/>
                <TextBlock Text="미리보기가 실제 아이콘과 맞는지 확인할 수 있습니다."
                           Foreground="#91A2B5" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button x:Name="StopButton" Content="오버레이 중지" Click="StopOverlay" IsEnabled="False"/>
                <Button x:Name="StartButton" Content="오버레이 실행" Click="StartOverlay"
                        Background="#16799A" FontWeight="Bold"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
